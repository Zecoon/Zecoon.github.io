---
layout: default
---
<div class="post home">
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name">
        {{ site.first_name }} {{ site.last_name }}
        {% if page.native_name %}<span class="native-name">{{ page.native_name }}</span>{% endif %}
      </h1>
      <p class="hero-role"><span class="lang-zh">{{ page.subtitle_zh }}</span><span class="lang-en">{{ page.subtitle }}</span></p>
      {% if page.highlight %}
        <div class="chips chips-highlight"><span class="chip chip-highlight"><span class="lang-zh">{{ page.highlight.zh }}</span><span class="lang-en">{{ page.highlight.en }}</span></span></div>
      {% endif %}
      {% if page.interests %}
        <div class="chips">
          {% for t in page.interests %}<span class="chip"><span class="lang-zh">{{ t.zh }}</span><span class="lang-en">{{ t.en }}</span></span>{% endfor %}
        </div>
      {% endif %}
      <div class="hero-bio">{{ content }}</div>
      {% if page.social %}
        <div class="hero-social">{% social_links %}</div>
      {% endif %}
    </div>
    <div class="hero-photo">
      {% if page.profile.image %}
        <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
      {% else %}
        <div class="photo-placeholder">{{ site.first_name | slice: 0 }}{{ site.last_name | slice: 0 }}</div>
      {% endif %}
      {% if page.profile.more_info %}<div class="more-info">{{ page.profile.more_info }}</div>{% endif %}
    </div>
  </section>

  {% if site.data.education %}
    <section class="home-section">
      <h2><span class="sec-ico"><i class="fa-solid fa-graduation-cap"></i></span><span class="lang-zh">教育经历</span><span class="lang-en">Education</span></h2>
      <ul class="edu-list">
        {% for e in site.data.education %}
          <li class="edu-item">
            {% if e.logo %}<img class="edu-logo" src="{{ e.logo | prepend: '/assets/img/logos/' | relative_url }}" alt="{{ e.school }}" loading="lazy">{% endif %}
            <div class="edu-body">
              <div class="edu-school"><span class="lang-zh">{{ e.school_zh }}</span><span class="lang-en">{{ e.school }}</span></div>
              <div class="edu-degree"><span class="lang-zh">{{ e.degree_zh }}</span><span class="lang-en">{{ e.degree }}</span></div>
              {% if e.detail %}<div class="edu-detail"><i class="fa-solid fa-star"></i> <span class="lang-zh">{{ e.detail_zh }}</span><span class="lang-en">{{ e.detail }}</span></div>{% endif %}
            </div>
            <span class="year-pill">{{ e.years }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section">
      <h2><span class="sec-ico"><i class="fa-solid fa-bullhorn"></i></span><a href="{{ '/news/' | relative_url }}"><span class="lang-zh">新闻动态</span><span class="lang-en">News</span></a></h2>
      <div class="news-grid">
        {% assign news_items = site.news | reverse %}
        {% for item in news_items limit: page.announcements.limit %}
          <article class="news-card{% unless item.image %} news-card-noimg{% endunless %}">
            {% if item.image %}
              <div class="news-photo"><img src="{{ item.image | prepend: '/assets/img/news/' | relative_url }}" alt="" loading="lazy"></div>
            {% else %}
              <div class="news-photo news-photo-icon"><i class="fa-solid {{ item.icon | default: 'fa-star' }}"></i></div>
            {% endif %}
            <div class="news-body">
              <div class="news-meta">
                <span class="news-tag"><i class="fa-solid {{ item.icon | default: 'fa-star' }}"></i> <span class="lang-zh">{{ item.tag_zh }}</span><span class="lang-en">{{ item.tag_en }}</span></span>
                <time>{{ item.date | date: '%Y.%m.%d' }}</time>
              </div>
              <div class="news-text">{{ item.content | remove: '<p>' | remove: '</p>' }}</div>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section">
      <h2><span class="sec-ico"><i class="fa-solid fa-book-open"></i></span><a href="{{ '/publications/' | relative_url }}"><span class="lang-zh">代表论文</span><span class="lang-en">Selected Publications</span></a></h2>
      <p class="section-note"><span class="lang-zh">查看<a href="{{ '/publications/' | relative_url }}">全部论文</a></span><span class="lang-en">See <a href="{{ '/publications/' | relative_url }}">all publications</a>.</span></p>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if site.data.honors %}
    <section class="home-section">
      <h2><span class="sec-ico"><i class="fa-solid fa-trophy"></i></span><span class="lang-zh">荣誉奖项</span><span class="lang-en">Honors &amp; Awards</span></h2>
      <ul class="honor-grid">
        {% for h in site.data.honors %}
          <li class="honor-card">
            <span class="honor-ico"><i class="fa-solid {{ h.icon | default: 'fa-award' }}"></i></span>
            <div class="honor-body">
              <div class="honor-title"><span class="lang-zh">{{ h.title_zh }}</span><span class="lang-en">{{ h.title }}</span></div>
              <div class="honor-meta">
                <span class="year-pill">{% if h.year_zh %}<span class="lang-zh">{{ h.year_zh }}</span><span class="lang-en">{{ h.year_en }}</span>{% else %}{{ h.year }}{% endif %}</span>
                {% if h.note_zh %}<span class="muted"><span class="lang-zh">{{ h.note_zh }}</span><span class="lang-en">{{ h.note }}</span></span>{% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% assign post_count = site.posts | size %}
  {% if page.latest_posts and page.latest_posts.enabled and post_count > 0 %}
    <section class="home-section">
      <h2><span class="sec-ico"><i class="fa-solid fa-pen-nib"></i></span><a href="{{ '/blog/' | relative_url }}"><span class="lang-zh">最新博客</span><span class="lang-en">Latest Posts</span></a></h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  {% if page.closing %}
    <section class="home-section closing">
      <div class="lang-zh">{{ page.closing_zh | markdownify }}</div>
      <div class="lang-en">{{ page.closing | markdownify }}</div>
    </section>
  {% endif %}

  <section class="home-section site-stats">
    <h2><span class="sec-ico"><i class="fa-solid fa-earth-asia"></i></span><span class="lang-zh">访客</span><span class="lang-en">Visitors</span></h2>
    <div class="stats-row">
      <div class="stat-card">
        <i class="fa-solid fa-eye"></i>
        <div><b id="busuanzi_value_site_pv">–</b><span class="lang-zh">总访问量</span><span class="lang-en">Page views</span></div>
      </div>
      <div class="stat-card">
        <i class="fa-solid fa-user-group"></i>
        <div><b id="busuanzi_value_site_uv">–</b><span class="lang-zh">访客数</span><span class="lang-en">Visitors</span></div>
      </div>
      <button class="stat-card like-btn" id="like-btn" type="button" aria-pressed="false">
        <i class="fa-regular fa-heart"></i>
        <div><b id="like-count">–</b><span class="lang-zh">点个赞</span><span class="lang-en">Likes</span></div>
      </button>
    </div>
    {% if page.visitor_map %}
      <div class="visitor-map" id="visitor-map">{{ page.visitor_map }}</div>
      <script>
        setTimeout(function () {
          var box = document.getElementById("visitor-map");
          if (box && !box.querySelector("svg, canvas, iframe, img")) {
            box.insertAdjacentHTML("beforeend",
              '<a href="https://mapmyvisitors.com/web/1c966" target="_blank" rel="noopener"><img class="map-fallback" src="https://mapmyvisitors.com/map.png?d=6wqg_AG1VM6jdTcJfssiuomr3wfJ0tTm7xi3gz8sdZ4&cl=ffffff" alt="visitor map"></a>');
          }
        }, 10000);
      </script>
    {% endif %}
  </section>
  <script defer src="https://events.vercount.one/js"></script>
  <script>
    (function () {
      var api = "https://abacus.jasoncameron.dev/", key = "zekunli-com/likes";
      var btn = document.getElementById("like-btn"), out = document.getElementById("like-count");
      var liked = false;
      try { liked = localStorage.getItem("zk-liked") === "1"; } catch (e) {}
      function show(v) { if (typeof v === "number" && v >= 0) out.textContent = v; }
      function mark() {
        btn.classList.add("liked");
        btn.setAttribute("aria-pressed", "true");
        btn.querySelector("i").className = "fa-solid fa-heart";
      }
      if (liked) mark();
      fetch(api + "get/" + key).then(function (r) { return r.json(); }).then(function (d) { show(d.value); }).catch(function () {});
      btn.addEventListener("click", function () {
        if (liked) return;
        liked = true;
        mark();
        btn.classList.add("pop");
        try { localStorage.setItem("zk-liked", "1"); } catch (e) {}
        fetch(api + "hit/" + key).then(function (r) { return r.json(); }).then(function (d) { show(d.value); }).catch(function () {});
      });
    })();
  </script>
</div>
